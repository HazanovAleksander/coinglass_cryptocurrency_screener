# CoinGlass Dashboard — Google OAuth2 (web flow) credentials
# Get these from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application").
#
# No refresh token is required: the first Google-Sheets export opens a
# browser consent page, and the resulting credentials are kept in the
# signed session cookie. In the Cloud Console add the callback to the
# client's "Authorized redirect URIs", e.g.
#   http://localhost:8080/api/export/google/callback
#
# Optional session-cookie signing secret (defaults to a dev value):
#   CG_SESSION_SECRET=
#
# Optional explicit OAuth2 redirect URI. By default it is derived from the
# request host (http://localhost:8080/api/export/google/callback). If the
# dashboard is reached through a proxy, remote host, domain, or Docker
# published port, set this to the exact "Authorized redirect URI" registered
# in Google Cloud Console, otherwise Google returns `redirect_uri_mismatch`.
#   CG_GOOGLE_REDIRECT_URI=https://your-host/api/export/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
